rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Cada usuario solo puede ver y modificar SU diario.
    match /users/{userId}/diary/{songId} {

      allow read, delete: if isOwner(userId);

      allow create: if isOwner(userId) && isValidEntry(request.resource.data);

      // Al modificar, además: una canción escuchada no puede volver a pendiente
      allow update: if isOwner(userId)
        && isValidEntry(request.resource.data)
        && (resource.data.listened == false || request.resource.data.listened == true);
    }

    // V4: el catálogo de álbumes.
    // Lo puede leer cualquiera (también sin ingresar), pero solo la administradora lo modifica.
    match /albums/{albumId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // La administradora es una sola cuenta: la mía, identificada por su id de usuario (uid)
    function isAdmin() {
      return request.auth != null && request.auth.uid == 'egJhMogvEvMyJB4g1hZ10cABFyU2';
    }

    // El usuario tiene que haber ingresado (con Google) y ser el dueño
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Controles básicos de los datos que se guardan.
    // Las pendientes (no escuchadas) tienen 0 estrellas y no pueden ser favoritas.
    // Las escuchadas tienen de 1 a 5 estrellas.
    function isValidEntry(data) {
      return data.rating is int
        && data.rating >= 0 && data.rating <= 5
        && (data.listened == false || data.rating >= 1)
        && (data.listened == true || data.favorite == false)
        && data.review is string
        && data.review.size() <= 500
        && data.listened is bool
        && data.favorite is bool
        && data.songTitle is string
        && data.albumId is string;
    }
  }
}
